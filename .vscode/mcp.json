{
  "inputs": [
    {
      "type": "promptString",
      "id": "refapp-token",
      "description": "Token RefApp (depuis Profil > Mes tokens dans l'interface)",
      "password": true
    }
  ],
  "servers": {
    "refappOpenapi": {
      "type": "http",
      "url": "http://localhost:9000/mcp",
      "headers": {
        "x-refapp-token": "${input:refapp-token}"
      }
    }
  }
}
